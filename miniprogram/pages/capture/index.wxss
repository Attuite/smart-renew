.page {
  padding: 28rpx 24rpx 48rpx;
}

.hero {
  padding: 20rpx 8rpx 30rpx;
}

.hero__eyebrow {
  color: #d97706;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.hero__title {
  margin-top: 10rpx;
  color: #102a43;
  font-size: 46rpx;
  font-weight: 800;
}

.hero__desc {
  margin-top: 10rpx;
  color: #627d98;
  font-size: 26rpx;
  line-height: 1.6;
}

.form-card,
.state-card {
  padding: 30rpx;
  border: 1rpx solid #d9e2ec;
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 14rpx 40rpx rgba(16, 42, 67, 0.08);
}

.state-card {
  color: #486581;
  text-align: center;
}

.state-card--error,
.submit-error {
  color: #c53030;
}

.small-button {
  width: 220rpx;
  margin-top: 24rpx;
  background: #102a43;
  color: #fff;
  font-size: 26rpx;
}

.field {
  margin-bottom: 28rpx;
}

.field__label {
  margin-bottom: 12rpx;
  color: #243b53;
  font-size: 28rpx;
  font-weight: 700;
}

.field__label text {
  color: #d64545;
}

.field__label .field__optional,
.problem-section__title text {
  margin-left: 10rpx;
  color: #829ab1;
  font-size: 22rpx;
  font-weight: 400;
}

.picker,
.input {
  box-sizing: border-box;
  width: 100%;
  min-height: 88rpx;
  padding: 22rpx 24rpx;
  border: 1rpx solid #bcccdc;
  border-radius: 14rpx;
  background: #f8fafc;
  color: #243b53;
  font-size: 28rpx;
}

.picker {
  position: relative;
}

.picker--placeholder,
.input::placeholder {
  color: #9fb3c8;
}

.picker__arrow {
  position: absolute;
  right: 24rpx;
  color: #829ab1;
  font-size: 40rpx;
  line-height: 32rpx;
}

.photo-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 6rpx;
}

.photo-hint {
  color: #829ab1;
  font-size: 23rpx;
}

.photo-count {
  color: #486581;
  font-size: 24rpx;
}

.photo-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-top: 20rpx;
}

.problem-section {
  margin-top: 30rpx;
  padding: 24rpx;
  border-radius: 18rpx;
  background: #f4f7fa;
}

.problem-section__title {
  color: #243b53;
  font-size: 30rpx;
  font-weight: 700;
}

.problem-section__hint {
  margin: 8rpx 0 24rpx;
  color: #829ab1;
  font-size: 23rpx;
}

.problem-section .field:last-child {
  margin-bottom: 0;
}

.photo-item,
.photo-add {
  position: relative;
  overflow: hidden;
  aspect-ratio: 1;
  border-radius: 14rpx;
}

.photo-item image {
  width: 100%;
  height: 100%;
}

.photo-add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed #9fb3c8;
  background: #f8fafc;
  color: #627d98;
  font-size: 24rpx;
}

.photo-add__icon {
  margin-bottom: 5rpx;
  font-size: 48rpx;
  line-height: 1;
}

.photo-remove {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(16, 42, 67, 0.82);
  color: #fff;
  font-size: 34rpx;
  line-height: 36rpx;
  text-align: center;
}

.photo-status {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 6rpx;
  background: rgba(34, 139, 94, 0.9);
  color: #fff;
  font-size: 20rpx;
  text-align: center;
}

.photo-status--pending {
  background: rgba(217, 119, 6, 0.9);
}

.uploaded-section {
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #d9e2ec;
}

.uploaded-section__title {
  margin-bottom: 16rpx;
  color: #243b53;
  font-size: 26rpx;
  font-weight: 700;
}

.uploaded-photo-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.uploaded-photo-grid image {
  width: 100%;
  aspect-ratio: 1;
  border-radius: 14rpx;
  background: #f4f7fa;
}

.progress {
  margin-top: 28rpx;
}

.progress__bar {
  overflow: hidden;
  height: 10rpx;
  border-radius: 10rpx;
  background: #d9e2ec;
}

.progress__bar view {
  height: 100%;
  border-radius: inherit;
  background: #d97706;
  transition: width 0.2s;
}

.progress__text {
  margin-top: 10rpx;
  color: #627d98;
  font-size: 23rpx;
  text-align: center;
}

.submit-button {
  margin-top: 34rpx;
  padding: 8rpx;
  background: #102a43;
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
}

.submit-button[disabled] {
  background: #829ab1;
  color: #e6edf3;
}

.submit-error {
  margin-top: 18rpx;
  font-size: 24rpx;
  line-height: 1.5;
  text-align: center;
}
