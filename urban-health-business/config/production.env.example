# Runtime
NODE_ENV=production
URBAN_HEALTH_HOST=0.0.0.0
URBAN_HEALTH_PORT=4182
URBAN_HEALTH_DATA_DIR=/var/lib/urban-health
SMART_RENEW_API_BASE=http://smart-renew:4173
SMART_RENEW_API_TIMEOUT_MS=8000

# Identity gateway integration.
# The reverse proxy MUST remove client-supplied x-authenticated-* headers and
# inject verified identity, roles and project claims.
URBAN_HEALTH_AUTH_MODE=required

# AMap browser SDK (public-by-design browser credentials).
AMAP_JS_KEY=
AMAP_JS_SECURITY_CODE=

# AMap Web Service (server-only; never expose through browser config or logs).
AMAP_WEB_SERVICE_KEY=

# GIS runtime policy
GIS_DEFAULT_MAP_STYLE=dark
GIS_COORDINATE_PROVIDER=gcj02-standard-formula
GIS_MAX_VIEW_FEATURES=5000
GIS_MAX_ROUTE_POINTS=100000
GIS_MAP_SNAPSHOT_STORAGE_PREFIX=map-snapshots/

# Transactional GIS record provider.
URBAN_HEALTH_PROVIDER=sqlite
URBAN_HEALTH_SQLITE_PATH=/var/lib/urban-health/business-records.sqlite

# Private S3-compatible storage for formal map snapshot objects.
GIS_MAP_SNAPSHOT_PROVIDER=s3
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# Optional CloudBase contract adapter remains available for an environment-specific integration.
TCB_ENV=
