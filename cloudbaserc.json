{
  "$schema": "https://static.cloudbase.net/cli/cloudbaserc.schema.json",
  "envId": "smart-renew-d2gamusvr1b96ce95",
  "functionRoot": "functions",
  "functions": [
    {
      "name": "api",
      "runtime": "Nodejs20.19",
      "handler": "index.main",
      "timeout": 120,
      "memorySize": 512,
      "description": "Smart Renew API for projects, indexed project data, analysis records and vision proxy",
      "envVariables": {
        "DASHSCOPE_MODEL": "qwen3-vl-plus",
        "DASHSCOPE_BASE_URL": "https://dashscope.aliyuncs.com/compatible-mode/v1",
        "GROUP_VISION_MODEL": "qwen3-vl-plus",
        "GROUP_VISION_BASE_URL": "https://jcpt.cscec.com/aijsxmywyapi/0510220001/v1.0/qwen3_vl_plus_public",
        "GROUP_VISION_API_KEY": "{{env.GROUP_VISION_API_KEY}}"
      }
    }
  ]
}
